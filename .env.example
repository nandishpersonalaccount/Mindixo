# ==============================================================================
# MINDIXO — Supabase Environment Configuration
# Copy this file to .env for local development or add these in Vercel Project Settings.
# ==============================================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Dashboard -> Project Settings -> API -> anon/public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Supabase Service Role Key (Required for server-side admin management, never expose to client)
# (Dashboard -> Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: PostgreSQL direct connection string (for migrations with drizzle)
# (Dashboard -> Project Settings -> Database -> Connection string)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
